{
  "name": "wealthfolio-binance-risk",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "vite build",
    "dev:server": "wealthfolio-addon dev",
    "package": "node scripts/package.mjs",
    "smoke": "node --import tsx scripts/smoke-package.mjs",
    "receipt": "node scripts/receipt.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run package && npm run smoke && npm run receipt && npm run verify:reader",
    "verify:reader": "node scripts/build-spot-reader.mjs && node --import tsx scripts/check-spot-reader.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@wealthfolio/addon-sdk": "3.9.0",
    "@wealthfolio/addon-dev-tools": "3.9.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.13",
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.2",
    "tsx": "4.20.5",
    "vite": "7.1.5"
  }
}
