{
  "id": "wealthfolio-binance-risk",
  "name": "币安资产监控",
  "version": "0.1.9",
  "description": "独立小额Spot直接只读同步；本人确认日志剩余风险，自动刷新仅页面可见时运行。",
  "author": "个人项目",
  "main": "dist/addon.js",
  "sdkVersion": "3.9.0",
  "minWealthfolioVersion": "3.9.1",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "wealthfolio-binance-risk"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "wealthfolio-binance-risk",
          "route": "wealthfolio-binance-risk",
          "label": "币安资产监控",
          "icon": "squares-four",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "react": "^19.2.0",
    "@wealthfolio/addon-sdk": "^3.9.0"
  },
  "permissions": [
    {
      "category": "secrets",
      "functions": [
        "set",
        "get",
        "delete"
      ],
      "purpose": "本机 Binance Spot API Key/Secret 仅通过官方 secrets 保存、读取和删除"
    },
    {
      "category": "files",
      "functions": [
        "openSaveDialog"
      ],
      "purpose": "导出严格白名单的固定模拟状态"
    },
    {
      "category": "network",
      "functions": [
        "request"
      ],
      "purpose": "固定公开GET行情；本人确认后仅GET Spot account及apiRestrictions，无交易/划转/提现"
    }
  ],
  "network": {
    "allowedHosts": [
      "data-api.binance.vision",
      "api.binance.com"
    ]
  }
}
