{
  "id": "wealthfolio-binance-risk",
  "name": "币安资产总览",
  "version": "0.4.0",
  "description": "Binance Spot 只读连接、原生账户同步与成本基础；历史估值与公开行情独立，未核实成本不计算盈亏。",
  "author": "个人项目",
  "main": "dist/addon.js",
  "sdkVersion": "3.9.0",
  "minWealthfolioVersion": "3.9.1",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "wealthfolio-binance-risk"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "wealthfolio-binance-risk",
          "route": "wealthfolio-binance-risk",
          "label": "币安资产总览",
          "icon": "squares-four",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "react": "^19.2.0",
    "@wealthfolio/addon-sdk": "^3.9.0"
  },
  "permissions": [
    {
      "category": "secrets",
      "functions": [
        "set",
        "get",
        "delete"
      ],
      "purpose": "本机 Binance Spot API Key/Secret 仅通过官方 secrets 保存、读取和删除"
    },
    {
      "category": "files",
      "functions": [
        "openSaveDialog"
      ],
      "purpose": "导出严格白名单的固定模拟状态"
    },
    {
      "category": "network",
      "functions": [
        "request"
      ],
      "purpose": "固定公开GET行情；本人确认后仅GET Spot account及apiRestrictions，无交易/划转/提现"
    },
    {
      "category": "accounts",
      "functions": [
        "getAll",
        "create"
      ],
      "purpose": "读取账户列表以识别已绑定的 Binance 账户；仅在本人预览并确认后创建独立的 CRYPTOCURRENCY 只读账户，不修改其他账户"
    },
    {
      "category": "snapshots",
      "functions": [
        "getAll",
        "getByDate",
        "checkImport",
        "save"
      ],
      "purpose": "本人确认后写入当日持仓快照，并读回数量对账；checkImport 仅用于写入前预览"
    },
    {
      "category": "quotes",
      "functions": [
        "update"
      ],
      "purpose": "把 Binance 公开行情写入已映射资产的报价；跳过手动报价资产"
    },
    {
      "category": "assets",
      "functions": [
        "updateQuoteMode"
      ],
      "purpose": "把本连接器管理的资产设为 MANUAL，停止宿主默认提供者反复请求不兼容的行情；不修改资产身份或其他账户持仓"
    },
    {
      "category": "currency",
      "functions": [
        "getAll",
        "getRatesForDates"
      ],
      "purpose": "只读检查 USDT 到基础货币的汇率是否存在，缺失时阻止写入"
    },
    {
      "category": "settings",
      "functions": [
        "get"
      ],
      "purpose": "只读用户的基础货币设置，用于判断是否需要 USDT 汇率"
    }
  ],
  "network": {
    "allowedHosts": [
      "data-api.binance.vision",
      "api.binance.com"
    ]
  }
}
